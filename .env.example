# ── Database Configuration ──────────────────────────────────────────────────
# Server hostname or IP address (e.g. localhost, 127.0.0.1, or sql-server.example.com)
DB_SERVER=localhost

# Database name
DB_DATABASE=boarding_house_db

# SQL Server Authentication (REQUIRED for Linux / Docker / Cloud Hosting)
# Leave DB_USER blank to fall back to Windows Authentication (msnodesqlv8) for local Windows dev
DB_USER=
DB_PASSWORD=
DB_PORT=1433

# SSL/TLS options for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Windows Authentication ODBC driver (Only applicable for Windows local dev)
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── Application Configuration ───────────────────────────────────────────────
PORT=3000
# Set to 'production' when deploying (enables secure cookies, trust proxy, strict sameSite)
NODE_ENV=development
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Server refuses to start in production if missing or shorter than 32 characters
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production

# ── Payment Gateway (PayMongo) ──────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_test_xxx

# ── AI API Keys ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
XAI_API_KEY=your_xai_api_key
GROQ_API_KEY=your_groq_api_key

# ── Email Service (Nodemailer SMTP) ─────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

RENT_DUE_DAY=29
EMAIL_REMINDER_USER=your_email@gmail.com
EMAIL_REMINDER_PASS=your_app_password

# ── OSINT & Verification APIs ───────────────────────────────────────────────
ABSTRACT_API_PHONE_KEY=
NUMVERIFY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
EMAILREP_API_KEY=
